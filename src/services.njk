{% extends "base.njk" %}
{% block main_content %}
    <main style="margin-top: -1px;">
		<!-- Services Section -->
		<section id="services" class="white" style="padding-top: 4rem">
			<h3 id="services-title">Ofertele Noastre</h3>
			<h2 id="services-heading">
				Soluții de Planificare pentru Fiecare Eveniment
			</h2>
			<p id="services-description">
				Vă transformăm viziunea într-un eveniment de neuitat. De la prima discuție la momentul culminant,
				asigurăm un parcurs plăcut și o zi perfectă.
			</p>
            
			<div id="services-details" class="services-details">
				<!-- Service Cards Grid -->
				<div class="main-services">
					<!-- Gold Planning Card -->
					<div class="card">
						<h4>Servicii Gold</h4>
						<p>Pentru persoanele care stiu ce vor, au locatia si o parte din furnizori, dar doresc o
							experienta completa fara griji.</p>
						<ul>
							<li>Coordonare in ziua evenimentului</li>
							<li>Doua sedinte de consultanta inaintea evenimentului</li>
							<li>Crearea unui plan detaliat de eveniment</li>
							<li>Coordonarea furnizorilor in ziua evenimentului</li>
							<li>Asistenta pe durata intregului eveniment (max. 12 ore)</li>
						</ul>
						<div id="gold_price"
							class="price hover:shadow-2xl transition duration-200 transform hover:-translate-y-1 border border-primary/50">
							800 Euro
						</div>
					</div>
					<!-- Platinum Planning -->
					<div class="card">
						<h4>Servicii Platinum</h4>
						<p>Aveti stabilita data si locatia, dar aveti nevoie de ajutor pentru a aduce totul impreuna.
						</p>
						<ul>
							<li>Tot ce contine pachetul "Gold"</li>
							<li>Asistenta in selectaerea furnizorilor pentru max. 5 categorii</li>
							<li>Trei sedinte suplimentare de consultanta</li>
						</ul>
						<div id="platinum_price"
							class="price hover:shadow-2xl transition duration-200 transform hover:-translate-y-1 border border-primary/50">
							1200 Euro
						</div>
					</div>
					<!-- Diamond Card -->
					<div class="card">
						<h4>Servicii Diamond</h4>
						<p>Relaxați-vă complet, noi preluăm întreaga organizare. Gestionăm fiecare detaliu, de la A la
							Z.</p>
						<ul>
							<li>Coordonare integrala a evenimentului</li>
							<li>Crearea conceptului tematic si designului</li>
							<li>Selectarea, rezervarea si gestionarea tuturor furnizorilor</li>
							<li>Plan financiar si monitorizare buget</li>
							<li>Coordonare in ziua evenimentului, cu asistent</li>
						</ul>
						<div id="diamond_price"
							class="price hover:shadow-2xl transition duration-200 transform hover:-translate-y-1 border border-primary/50">
							2500 Euro</div>
					</div>
				</div>
		</section>
		<section class="white">
			<h3>Servicii Suplimentare</h3>
			<h2>
				Opțiuni Extra Pentru Evenimentul Tău
			</h2>
			<div>
				<p>
					Completează experiența cu servicii personalizate, pentru ca fiecare detaliu să fie perfect
					adaptat dorințelor tale.
				</p>
			</div>
			<div id="additional-details" class="additional-details">
				<div class="small-card">
					<h4>Consultare inițială</h4>
					<p>Încercăm să te cunoastem, să îți înțelegem dorințele și să cădem de comun acord asupra
						detaliilor.</p>
					<div class="price">100 Euro</div>
				</div>
				<div class="small-card">
					<h4>Creare concept și design personalizat</h4>
					<p>Transformăm ideile tale în decoruri și tematici unice.</p>
					<div class="price">300-500 Euro</div>
				</div>
				<div class="small-card">
					<h4>Planificare cerere în căsătorie</h4>
					<p>Te ajutăm să creezi un moment memorabil pentru a spune "DA".</p>
					<div class="price">200 Euro</div>
				</div>
				<div class="small-card">
					<h4>Organizare petrecere logodnă</h4>
					<p>Petrecere de logodnă organizată cu atenție la detalii.</p>
					<div class="price">400 Euro</div>
				</div>
				<div class="small-card">
					<h4>Consiliere vestimentație</h4>
					<p>Sfaturi personalizate pentru alegerea ținutelor perfecte.</p>
					<div class="price">100 Euro / Persoană</div>
				</div>
				<div class="small-card">
					<h4>Coordonare evenimente conexe</h4>
					<p>Gestionăm cu profesionalism evenimentele asociate.</p>
					<div class="price">250-400 Euro</div>
				</div>
			</div>
			<!-- Back button -->
			<a class="btn" href="/#services">Înapoi</a>
		</section>
    </main>
{% endblock %}
</body>
</html>
