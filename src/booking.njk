{% extends "base.njk" %}
{% block main_content %}
    <main style="margin-top: -1px;">
		<section id="booking" class="booking">
			<h3>Următorul pas</h3>
			<h2>
				Programați o sesiune de consultanță
			</h2>
			<p>
				Spuneți-ne puțin despre viziunea evenimentului și vom programa o discuție rapidă pentru a vedea cum
				putem să o aducem la viață.
			</p>
			<div id="booking-details" class="booking-details ">
				<!-- Booking Form -->
				<form id="consultationForm" class="consultation-form">
					<div class="content">
						<div>
							<label for="name" class="consultation-label">Nume</label>
							<input type="text" id="name" name="name" minlength="2" maxlength="100" placeholder="Ion Popescu" required
								class="consultation-input">
						</div>
						<div>
							<label for="email" class="consultation-label">Adresă de email</label>
							<input type="email" id="email" name="email" minlength="5" maxlength="100" placeholder="email@exemplu.com" required
								class="consultation-input">
						</div>
						<div>
							<label for="telephone" class="consultation-label">Număr de telefon</label>
							<input type="tel" id="telephone" name="telephone" minlength="5" maxlength="20" placeholder="(770) 123-4567" required
								class="consultation-input">
						</div>
						<div class="booking-cart-summary">
							<label class="consultation-label">Servicii selectate</label>
							<div id="booking-cart-items" class="booking-cart-items">
								<p class="booking-cart-empty">Nu ați selectat servicii. <a href="services.html">Vedeți serviciile noastre</a></p>
							</div>
							<div id="booking-cart-total" class="booking-cart-total" style="display:none;">
								<span>Total estimat:</span>
								<strong id="booking-total-value">0 Euro</strong>
							</div>
							<input type="hidden" id="services_data" name="services_data" value="">
						</div>
						<div>
							<label for="date" class="consultation-label">Data ședintei de consultanță</label>
							<input type="date" id="date" name="date" required class="consultation-input">
						</div>
						<div>
							<label for="timeslot" class="consultation-label">Alegeți intervalul orar dorit</label>
							<select id="timeslot" name="timeslot" required class="consultation-input">
								<option value="" disabled selected>Alegeți data ședintei întâi</option>
							</select>
						</div>
						<div>
							<label for="location" class="consultation-label">Alegeți locația de întâlnire</label>
							<select id="location" name="location" required class="consultation-input">
								<option value="" disabled selected>Selectați o locație</option>
								<option value="online">Online</option>
								<option value="sediu">La sediu (Urseni)</option>
								<option value="cafea">La o cafea (Timișoara)</option>
							</select>
						</div>
						<div>
							<label for="message" class="consultation-label">Alte notițe...</label>
							<textarea id="message" name="message" rows="4" maxlength="100" placeholder="Alte notițe..."
								class="consultation-input"></textarea>
						</div>
						<div class="gdpr-checkbox">
							<input type="checkbox" id="consentCheckbox" required>
							<input type="hidden" id="gdprTimestamp" name="gdprTimestamp" value="">
							<label for="consentCheckbox">
								Am citit și sunt de acord cu <a href="gdpr.html" target="_blank"
									id="gdpr-policy-link">politica de confidențialitate (GDPR)</a>
							</label>
						</div>
					</div>
					<button id="consultation-submit-button" type="submit" class="consultation-submit-button">Trimiteți
						și solicitați un apel</button>
					<p>Nu vom împărtăși niciodată informațiile dvs. Așteptați un răspuns în termen de 24 de ore.</p>
				</form>
			</div>
			<a class="btn" href='/#booking'>Înapoi</a>
		</section>
    </main>
{% endblock %}
{% block scripts %}
	{{ super() }}
	{% set js %}{% include "static/booking.js" %}{% endset %}
    {{ js | jsmin | safe }}
{% endblock %}
</body>
</html>
